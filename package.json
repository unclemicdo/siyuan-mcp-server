{
  "name": "siyuan-mcp-server",
  "version": "1.0.0",
  "description": "MCP server for SiYuan Note (思源笔记) API integration",
  "license": "MIT",
  "author": "Uncle Mic",
  "repository": {
    "type": "git",
    "url": "https://github.com/unclemicdo/siyuan-mcp-server"
  },
  "keywords": [
    "siyuan",
    "mcp",
    "note-taking",
    "思源笔记",
    "ai",
    "model-context-protocol"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "siyuan-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "README_en.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "vitest run",
    "prepare": "npm run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.9",
    "zod": "^3.23.8"
  },
  "overrides": {
    "hono": "^4.12.9",
    "path-to-regexp": "^8.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.2"
  }
}
